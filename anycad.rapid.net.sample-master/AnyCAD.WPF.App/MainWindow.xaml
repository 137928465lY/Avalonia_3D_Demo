<Window x:Class="AnyCAD.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:anycad="clr-namespace:AnyCAD.WPF;assembly=AnyCAD.WPF.NET"
        xmlns:local="clr-namespace:AnyCAD.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="AnyCAD Rapid .NET 三维示例库" Height="850" Width="1400"
        Loaded="Window_Loaded" WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="#17171A">
    <Window.Resources>
        <local:StringIsNonEmptyConverter x:Key="StringIsNonEmptyConverter"/>
        <!-- 分类 chips：豆包深色：未选 #2E2E33 / 选中 #3370FF -->
        <Style x:Key="ChipRadioItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C8C8CE"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#2E2E33" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3370FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器：豆包深色卡片 #2A2A2E，hover/selected 描豆包蓝 -->
        <Style x:Key="SampleCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="#2A2A2E" CornerRadius="8"
                                BorderBrush="#3A3A40" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3370FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3370FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#32323A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#17171A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="400" MinWidth="320" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- ====== 左侧：3D 视图 ====== -->
            <Grid Grid.Column="0">
                <anycad:RenderControl x:Name="mRenderCtrl" ViewerReady="RenderCtrl_ViewerReady"/>

                <!-- 浮动工具条：顶部居中叠加在三维视图上 -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0"
                        Background="#D82D2D30"
                        BorderBrush="#45454C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4,2">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style x:Key="VecIcon" TargetType="Path">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                <Setter Property="Stretch" Value="Uniform"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="UseLayoutRounding" Value="True"/>
                                <Setter Property="Fill" Value="Transparent"/>
                                <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="StrokeThickness" Value="1.2"/>
                                <Setter Property="StrokeStartLineCap" Value="Round"/>
                                <Setter Property="StrokeEndLineCap" Value="Round"/>
                                <Setter Property="StrokeLineJoin" Value="Round"/>
                            </Style>
                            <Style x:Key="IconZoomToFit" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M1.6,5.6 L1.6,1.6 L5.6,1.6 M10.4,1.6 L14.4,1.6 L14.4,5.6 M14.4,10.4 L14.4,14.4 L10.4,14.4 M5.6,14.4 L1.6,14.4 L1.6,10.4 M5.2,5.2 L10.8,5.2 L10.8,10.8 L5.2,10.8 Z"/>
                            </Style>
                            <Style x:Key="IconRectZoom" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M1.6,4 L1.6,1.6 L4,1.6 M12,1.6 L14.4,1.6 L14.4,4 M14.4,12 L14.4,14.4 L12,14.4 M4,14.4 L1.6,14.4 L1.6,12 M4.6,4.6 L7.4,4.6 L7.4,7.4 L4.6,7.4 Z M7,7 L10.2,10.2"/>
                            </Style>
                            <Style x:Key="IconPan" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M8,1.8 L8,14.2 M1.8,8 L14.2,8 M8,1.8 L5.9,4.3 M8,1.8 L10.1,4.3 M8,14.2 L5.9,11.7 M8,14.2 L10.1,11.7 M1.8,8 L4.3,5.9 M1.8,8 L4.3,10.1 M14.2,8 L11.7,5.9 M14.2,8 L11.7,10.1"/>
                            </Style>
                            <Style x:Key="IconClipPlane" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M2.4,5.6 L8,2.8 L13.6,5.6 L13.6,10.4 L8,13.2 L2.4,10.4 Z M2.4,5.6 L8,8.4 L13.6,5.6 M8,8.4 L8,13.2 M1.4,12.6 L14.6,2.6"/>
                            </Style>
                            <Style x:Key="IconPick" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M3.6,2.2 L3.6,12.6 L6.6,9.9 L8.8,14.2 L10.9,13.2 L8.7,9.1 L12.6,8.9 Z"/>
                            </Style>
                            <!-- 透视投影：视锥（矩形左边两角汇聚到右边一点） -->
                            <Style x:Key="IconPerspective" TargetType="Path" BasedOn="{StaticResource VecIcon}">
                                <Setter Property="Data" Value="M1.5,2.5 L14.5,2.5 L14.5,13.5 L1.5,13.5 Z M1.5,2.5 L11,8 M1.5,13.5 L11,8"/>
                            </Style>
                            <Style x:Key="FloatToolButton" TargetType="Button">
                                <Setter Property="Width" Value="30"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="FloatToolToggle" TargetType="ToggleButton">
                                <Setter Property="Width" Value="30"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3370FF"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#4D6BFE"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <Button Style="{StaticResource FloatToolButton}" Tag="ZoomToFit" ToolTip="缩放至适配" Click="ToolbarCommand_Click">
                            <Path Style="{StaticResource IconZoomToFit}"/>
                        </Button>
                        <ToggleButton Style="{StaticResource FloatToolToggle}" Tag="RectZoom" ToolTip="框选放大" Click="ToolbarCommand_Click">
                            <Path Style="{StaticResource IconRectZoom}"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FloatToolToggle}" Tag="Pan" ToolTip="平移" Click="ToolbarCommand_Click">
                            <Path Style="{StaticResource IconPan}"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FloatToolToggle}" Tag="ClipPlane" ToolTip="剖切平面" Click="ToolbarCommand_Click">
                            <Path Style="{StaticResource IconClipPlane}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="PickToggle" Style="{StaticResource FloatToolToggle}" Tag="Pick" ToolTip="拾取" Click="ToolbarCommand_Click">
                            <Path Style="{StaticResource IconPick}"/>
                        </ToggleButton>
                        <!-- 分隔 -->
                        <Border Width="1" Margin="6,4" Background="#45454C"/>
                        <ToggleButton x:Name="PerspectiveToggle" Style="{StaticResource FloatToolToggle}"
                                      ToolTip="透视 / 正交投影切换"
                                      Click="ProjectionToggle_Click">
                            <Path Style="{StaticResource IconPerspective}"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="#3A3A40"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ====== 右侧：Gallery 浏览面板（豆包深色） ====== -->
            <Border Grid.Column="2" Background="#1E1E22" BorderThickness="1,0,0,0" BorderBrush="#2E2E33">
                <DockPanel Margin="0">
                    <!-- 标题 -->
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <TextBlock Text="示例库" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#E8E8EA" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#9999A0" FontSize="11"
                                   Text="{Binding FilteredSamples.Count, StringFormat={}{0} 项}"/>
                    </DockPanel>

                    <!-- 搜索框 -->
                    <Border DockPanel.Dock="Top" Margin="12,0,12,6"
                            Background="#2A2A2E" CornerRadius="6"
                            BorderBrush="#3A3A40" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Margin="8,5"
                                     Padding="0,0,26,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E8E8EA"
                                     CaretBrush="#3370FF"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Margin="10,7,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="#6B6B73" Text="🔍 搜索标题/描述/标签/文件名...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 清空搜索：仅当搜索框有内容时显示；点击清空并回焦 -->
                            <Button x:Name="ClearSearchButton"
                                    Content="✕"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Padding="4,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearSearch_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#6B6B73"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#C8C8CE"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 标签 chips（按 Tags 过滤） -->
                    <ListBox DockPanel.Dock="Top"
                             ItemsSource="{Binding AllTags}"
                             SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="12,0,12,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipRadioItem}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 卡片网格（空态：无匹配时居中提示） -->
                    <Grid>
                    <ListBox ItemsSource="{Binding FilteredSamples}"
                             SelectedItem="{Binding SelectedSample}"
                             SelectionChanged="SampleGrid_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource SampleCardStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:SampleInfo">
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- 默认无 tooltip；Description 非空时才挂深色气泡 -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description, Converter={StaticResource StringIsNonEmptyConverter}}" Value="True">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Background="#2A2A2E" Foreground="#E8E8EA"
                                                                     BorderBrush="#3A3A40" Padding="8,6">
                                                                <TextBlock Text="{Binding Description}"
                                                                           MaxWidth="280" TextWrapping="Wrap"
                                                                           LineHeight="18"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- 缩略图区 -->
                                        <Grid Height="110" Background="#2E2E33">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            <TextBlock Text="无预览图"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#6B6B73" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- bundle 角标 -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,4,4,0"
                                                    Background="#3A3A40" CornerRadius="3" Padding="5,1">
                                                <TextBlock Text="{Binding BundleBadge}" Foreground="#C8C8CE" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                        <!-- 标题区：中文 Title 主显，英文 Name 辅助小字 -->
                                        <StackPanel Margin="8,6,8,8">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       FontSize="12" Foreground="#E8E8EA"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#7A7A82" FontSize="10" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GroupDisplayName}"
                                                       Foreground="#9999A0" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 空态：FilteredSamples 为 0 时居中提示 -->
                    <TextBlock Text="没有匹配的示例"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#6B6B73" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredSamples.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        <StatusBar Grid.Row="1" Background="#17171A" Foreground="#9999A0" BorderBrush="#2E2E33">
            <StatusBarItem Width="200" Content="{Binding MousePosition}"/>
        </StatusBar>
    </Grid>
</Window>
